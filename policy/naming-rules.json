    "langfuse",
    "braintrust",
    "agnost",
    "langsmith",
    "helicone",
    "arize",
    "opik",
    "lunary",
    "honeyhive",
    "traceloop",
    "openllmetry",
    "agentops",
    "portkey",
    "humanloop",
    "openinference",
    "logfire",
    "agentcat",
    "mcpcat",
    "shinzo",
    "firecrawl",
    "mendable"
  ],
  "vendor_allowed_paths": [
    "crates/crucible-compat/",
    "docs/integrations/",
    "docs/migration/",
    "docs/comparison/",
    "THIRD_PARTY_NOTICES",
    "policy/",
    "tools/policy/"
  ],
  "always_flag": [
    "ported from",
    "clone of",
    "remake",
    "reimplementation of",
    "re implementation of",
    "parity with",
    "feature parity",
    "inspired by",
    "copied from",
    "replica of",
    "borrowed from",
    "lifted from"
  ],
  "context_flag": [
    "port of",
    "cloned from",
    "derived from",
    "translated from",
    "modeled on",
    "modelled on",
    "based on",
    "same as",
    "drop in replacement",

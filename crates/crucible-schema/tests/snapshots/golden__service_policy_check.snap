---
source: crates/crucible-schema/tests/golden.rs
expression: service_policy_check(&params().admin_user)
---
SELECT count() FROM system.row_policies WHERE database = 'crucible' AND short_name = concat('crucible_service_', table) AND is_restrictive = 0 AND select_filter = '1' AND hasAll(apply_to_list, ['crucible_admin', 'crucible_ingest', 'crucible_read_ui', 'crucible_read_agent', 'crucible_maint'])

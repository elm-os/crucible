---
source: crates/crucible-schema/tests/golden.rs
expression: script(&step)
---
CREATE TABLE IF NOT EXISTS crucible.mcp_tool_rollup_hourly
(
    `project_id` UUID CODEC(ZSTD(1)),
    `side` Enum8('none' = 0, 'client' = 1, 'server' = 2) CODEC(ZSTD(1)),
    `hour` DateTime('UTC') CODEC(ZSTD(1)),
    `server_name` LowCardinality(String) CODEC(ZSTD(1)),
    `deploy_id` String CODEC(ZSTD(1)),
    `capture_source` Enum8('sdk' = 1, 'proxy_stdio' = 2, 'proxy_http' = 3, 'otlp' = 4) CODEC(ZSTD(1)),
    `era` Enum8('legacy' = 1, 'modern' = 2) CODEC(ZSTD(1)),
    `method` LowCardinality(String) CODEC(ZSTD(1)),
    `target_name` LowCardinality(String) CODEC(ZSTD(1)),
    `client_name` LowCardinality(String) CODEC(ZSTD(1)),
    `error_class` Enum8('none' = 0, 'protocol' = 1, 'validation' = 2, 'not_found' = 3, 'tool_execution' = 4, 'auth' = 5, 'rate_limit' = 6, 'timeout' = 7, 'transport' = 8, 'cancelled' = 9, 'internal' = 10) CODEC(ZSTD(1)),
    `caller_fault` UInt8 CODEC(ZSTD(1)),
    `marker_epoch` UUID CODEC(ZSTD(1)),
    `marker_batch_seq` UInt64 CODEC(T64, ZSTD(1)),
    `marker_at` SimpleAggregateFunction(max, DateTime('UTC')) CODEC(ZSTD(1)),
    `count` SimpleAggregateFunction(sum, UInt64) CODEC(T64, ZSTD(1)),
    `request_bytes` SimpleAggregateFunction(sum, UInt64) CODEC(T64, ZSTD(1)),
    `response_bytes` SimpleAggregateFunction(sum, UInt64) CODEC(T64, ZSTD(1)),
    `dur_hist` SimpleAggregateFunction(sumMap, Tuple(Array(UInt16), Array(UInt64))) CODEC(ZSTD(1)),
    `semconv_hist` SimpleAggregateFunction(sumMap, Tuple(Array(UInt8), Array(UInt64))) CODEC(ZSTD(1)),
    `last_seen` SimpleAggregateFunction(max, DateTime64(6, 'UTC')) CODEC(Delta(8), ZSTD(1))
)
ENGINE = AggregatingMergeTree
PARTITION BY toYYYYMM(hour)
PRIMARY KEY (project_id, side, hour)
ORDER BY (project_id, side, hour, server_name, deploy_id, capture_source, era, method, target_name, client_name, error_class, caller_fault, marker_epoch, marker_batch_seq)
SETTINGS index_granularity = 8192, non_replicated_deduplication_window = 20000;

GRANT INSERT, SELECT(project_id, marker_epoch, marker_batch_seq, _partition_id) ON crucible.mcp_tool_rollup_hourly TO crucible_ingest;

GRANT ALTER UPDATE(_row_exists) ON crucible.mcp_tool_rollup_hourly TO crucible_maint;

CREATE ROW POLICY IF NOT EXISTS crucible_service_mcp_tool_rollup_hourly ON crucible.mcp_tool_rollup_hourly AS PERMISSIVE FOR SELECT USING 1 TO crucible_admin, crucible_ingest, crucible_read_ui, crucible_read_agent, crucible_maint;

SELECT throwIf((SELECT count() FROM crucible.mcp_tool_rollup_hourly) > 0 AND (SELECT count() FROM crucible.mcp_tool_rollup_hourly WHERE project_id = toUUID('00000000-0000-0000-0000-000000000000') AND marker_epoch = toUUID('00000000-0000-7000-8000-000000000001') AND _partition_id = '197001') = 0, 'An earlier copy of crucible.mcp_tool_rollup into crucible.mcp_tool_rollup_hourly did not finish, so the hourly table is incomplete. Stop every Crucible server. Then, as the ClickHouse admin user, end the copy in case ClickHouse still runs it, with KILL QUERY WHERE query LIKE \'INSERT INTO crucible.mcp_tool_rollup_hourly%\' SYNC, empty the table with TRUNCATE TABLE crucible.mcp_tool_rollup_hourly, and migrate again (crucible migrate, or crucible serve --migrate).');

INSERT INTO crucible.mcp_tool_rollup_hourly (project_id, marker_epoch, marker_at) SELECT toUUID('00000000-0000-0000-0000-000000000000'), toUUID('00000000-0000-7000-8000-000000000002'), now() WHERE (SELECT count() FROM crucible.mcp_tool_rollup_hourly WHERE project_id = toUUID('00000000-0000-0000-0000-000000000000') AND marker_epoch = toUUID('00000000-0000-7000-8000-000000000001') AND _partition_id = '197001') = 0;

INSERT INTO crucible.mcp_tool_rollup_hourly (project_id, side, hour, server_name, deploy_id, capture_source, era, method, target_name, client_name, error_class, caller_fault, marker_epoch, marker_batch_seq, marker_at, count, request_bytes, response_bytes, dur_hist, semconv_hist, last_seen) SELECT project_id, side, toStartOfHour(minute) AS copied_hour, server_name, deploy_id, capture_source, era, method, target_name, client_name, error_class, caller_fault, if(project_id = toUUID('00000000-0000-0000-0000-000000000000'), marker_epoch, toUUID('00000000-0000-0000-0000-000000000000')) AS copied_marker_epoch, if(project_id = toUUID('00000000-0000-0000-0000-000000000000'), marker_batch_seq, 0) AS copied_marker_batch_seq, max(marker_at), sum(count), sum(request_bytes), sum(response_bytes), sumMap(dur_hist), sumMap(semconv_hist), max(last_seen) FROM crucible.mcp_tool_rollup WHERE (SELECT count() FROM crucible.mcp_tool_rollup_hourly WHERE project_id = toUUID('00000000-0000-0000-0000-000000000000') AND marker_epoch = toUUID('00000000-0000-7000-8000-000000000001') AND _partition_id = '197001') = 0 GROUP BY project_id, side, copied_hour, server_name, deploy_id, capture_source, era, method, target_name, client_name, error_class, caller_fault, copied_marker_epoch, copied_marker_batch_seq;

INSERT INTO crucible.mcp_tool_rollup_hourly (project_id, marker_epoch, marker_at) SELECT toUUID('00000000-0000-0000-0000-000000000000'), toUUID('00000000-0000-7000-8000-000000000001'), now() WHERE (SELECT count() FROM crucible.mcp_tool_rollup_hourly WHERE project_id = toUUID('00000000-0000-0000-0000-000000000000') AND marker_epoch = toUUID('00000000-0000-7000-8000-000000000001') AND _partition_id = '197001') = 0;

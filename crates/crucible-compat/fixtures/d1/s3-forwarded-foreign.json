{
  "provenance": {
    "values": "invented",
    "shape": "synthetic: a span of another instrumentation forwarded by the dialect 1 SDK, which stamps its trace keys",
    "license_of_the_shape_source": "MIT",
    "envelope": "synthesized: the trace id is 16 bytes of 0xD1, span ids count from 1 in listed order, and times are 1 s and 2 s after the epoch unless the fixture needs others",
    "notes": "The span-kind key detects dialect 2 at confidence 90, above the request hint, so the bare metadata key of dialect 2 is read; the namespaced trace-name key of dialect 1 maps on every span."
  },
  "request": {
    "path": "/api/public/otel/v1/traces",
    "headers": {}
  },
  "otlp": {
    "resourceSpans": [
      {
        "scopeSpans": [
          {
            "scope": {
              "name": "my.app"
            },
            "spans": [
              {
                "traceId": "d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1",
                "spanId": "0000000000000001",
                "name": "retrieve",
                "kind": 1,
                "startTimeUnixNano": "1000000000",
                "endTimeUnixNano": "2000000000",
                "attributes": [
                  {
                    "key": "openinference.span.kind",
                    "value": {
                      "stringValue": "CHAIN"
                    }
                  },
                  {
                    "key": "metadata",
                    "value": {
                      "stringValue": "{\"team\":\"search\"}"
                    }
                  },
                  {
                    "key": "langfuse.trace.name",
                    "value": {
                      "stringValue": "forwarded"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "expect": {
    "0000000000000001": {
      "compat_dialect": 2,
      "source_format": "compat",
      "observation_type": "chain",
      "trace_name": "forwarded",
      "metadata": {
        "team": "search"
      },
      "residual": []
    }
  }
}

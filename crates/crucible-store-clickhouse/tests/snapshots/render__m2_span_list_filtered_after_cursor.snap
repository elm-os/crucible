SELECT start_minute, trace_hash, start_time, end_time, span_id, parent_span_id, trace_id, is_root, is_app_root, clock_skew, kind, status_code, observation_type, level, trace_public, cost_source, mcp_side, io_shape, input_truncation, output_truncation, source_format, name, status_message, service_version, scope_version, telemetry_sdk_version, sdk_version, release, version, trace_name, user_id, session_id, prompt_name, prompt_version, service_name, scope_name, telemetry_sdk_name, telemetry_sdk_language, sdk_name, environment, model_requested, model_response, provider, duration_us, input_tokens, output_tokens, total_tokens, input_bytes, output_bytes, completion_start_time, trace_tags, tags, tool_names, finish_reasons, usage_keys, usage_values, cost_values, total_cost_nusd, price_model_id, price_tier_id, api_key_id, tool_call_count, normalizer_version, event_bytes, compat_dialect, input_preview, output_preview, input_sha256, output_sha256, row_digest, usage_aggregate, wal_epoch, batch_seq, lsn, received_at FROM crucible.span_core WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND received_at <= {p5:DateTime64(6, 'UTC')} AND ((hasAny(tags, {p6:Array(String)}) OR (positionCaseInsensitiveUTF8(name, {p7:String}) > 0 AND (lengthUTF8({p7:String}) < 3 OR hasAllTokens(name, {p7:String})))) AND NOT (user_id IN {p8:Array(String)}) AND environment IN {p9:Array(String)} AND release IN {p10:Array(String)} AND version IN {p11:Array(String)} AND session_id IN {p12:Array(String)} AND level IN {p13:Array(String)} AND observation_type IN {p14:Array(String)}) AND (start_minute, start_time, span_id) < ({p15:DateTime('UTC')}, {p16:DateTime64(6, 'UTC')}, unhex({p17:String})) ORDER BY start_minute DESC, start_time DESC, span_id DESC LIMIT {p18:UInt64}

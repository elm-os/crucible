---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&live(mcp_users(s, w, &c, caller, &read, 50)))"
---
SELECT user_id, user_subject_hash, count() AS m0, min(start_time) AS m1, max(start_time) AS m2, uniqCombined64(group_key) AS m3, max(identity_source) AS m4 FROM crucible.mcp_ops WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND (side = {p5:String} AND capture_source IN ({p6:String}) AND caller_fault = {p7:UInt8} AND (user_id != {p8:String} OR user_subject_hash != unhex({p9:String}))) GROUP BY user_id, user_subject_hash ORDER BY m2 DESC, user_id DESC, user_subject_hash DESC LIMIT {p10:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000000"
p3: DateTime('UTC') = "1794907800"
p4: DateTime('UTC') = "1794911340"
p5: String = "server"
p6: String = "sdk"
p7: UInt8 = "0"
p8: String = ""
p9: String = "00000000000000000000000000000000"
p10: UInt64 = "51"

SELECT start_time, trace_hash, trace_id, span_id, head_kind, end_time, name, level, status_code, user_id, session_id, tags, environment, release, version, input_preview, output_preview, wal_epoch, batch_seq, lsn, received_at FROM crucible.trace_heads WHERE project_id = {p6:UUID} AND start_time >= {p7:DateTime64(6, 'UTC')} AND start_time < {p8:DateTime64(6, 'UTC')} AND received_at <= {p9:DateTime64(6, 'UTC')} AND environment IN {p10:Array(String)} AND trace_id IN (SELECT trace_id FROM (SELECT trace_id, count() AS m0 FROM crucible.span_core WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND observation_type IN {p5:Array(String)} GROUP BY trace_id)) ORDER BY start_time DESC, trace_hash DESC, trace_id DESC LIMIT {p11:UInt64}

---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&live(mcp_sessions(s, w, &c, caller, &with_faults, 50)))"
---
SELECT group_key, group_key_kind, count() AS m0, min(start_time) AS m1, max(start_time) AS m2, max(client_name) AS m3 FROM crucible.mcp_ops WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND (side = {p5:String} AND capture_source IN ({p6:String}) AND group_key != {p7:String}) GROUP BY group_key, group_key_kind ORDER BY m2 DESC, group_key DESC, group_key_kind DESC LIMIT {p8:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000000"
p3: DateTime('UTC') = "1794907800"
p4: DateTime('UTC') = "1794911340"
p5: String = "server"
p6: String = "sdk"
p7: String = ""
p8: UInt64 = "51"

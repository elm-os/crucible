---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&mcp_metrics_ranking(s, w, &c, caller, &errors,\n&read).unwrap().unwrap())"
---
SELECT target_name, sum(count) AS m0 FROM crucible.mcp_tool_rollup WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND (side = {p3:String} AND ((server_name IN {p4:Array(String)} AND capture_source IN {p5:Array(String)}) OR (server_name IN {p6:Array(String)} AND capture_source IN {p7:Array(String)})) AND caller_fault = {p8:UInt8} AND error_class != {p9:String}) GROUP BY target_name ORDER BY m0 DESC, target_name ASC LIMIT {p10:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911340"
p3: String = "server"
p4: Array(String) = "['files']"
p5: Array(String) = "['sdk']"
p6: Array(String) = "['db']"
p7: Array(String) = "['proxy_stdio','proxy_http']"
p8: UInt8 = "0"
p9: String = "none"
p10: UInt64 = "6"

---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&live(mcp_servers(s, w, &c, caller, &read)))"
---
SELECT server_name, client_name, error_class, caller_fault, sum(count) AS m0, sumMap(dur_hist) AS m1, max(last_seen) AS m2 FROM (SELECT server_name, client_name, error_class, caller_fault, count, dur_hist, last_seen FROM crucible.mcp_tool_rollup WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND (minute < {p3:DateTime('UTC')} OR minute >= {p4:DateTime('UTC')}) AND (side = {p5:String} AND ((server_name IN {p6:Array(String)} AND capture_source IN {p7:Array(String)}) OR (server_name IN {p8:Array(String)} AND capture_source IN {p9:Array(String)}))) UNION ALL SELECT server_name, client_name, error_class, caller_fault, count, dur_hist, last_seen FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p10:UUID} AND hour >= {p11:DateTime('UTC')} AND hour <= {p12:DateTime('UTC')} AND (side = {p13:String} AND ((server_name IN {p14:Array(String)} AND capture_source IN {p15:Array(String)}) OR (server_name IN {p16:Array(String)} AND capture_source IN {p17:Array(String)})))) GROUP BY server_name, client_name, error_class, caller_fault
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1795512540"
p3: DateTime('UTC') = "1794909600"
p4: DateTime('UTC') = "1795510800"
p5: String = "server"
p6: Array(String) = "['files']"
p7: Array(String) = "['sdk']"
p8: Array(String) = "['db']"
p9: Array(String) = "['proxy_stdio','proxy_http']"
p10: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p11: DateTime('UTC') = "1794909600"
p12: DateTime('UTC') = "1795510740"
p13: String = "server"
p14: Array(String) = "['files']"
p15: Array(String) = "['sdk']"
p16: Array(String) = "['db']"
p17: Array(String) = "['proxy_stdio','proxy_http']"

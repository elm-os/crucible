---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&live(mcp_servers(s, w, &c, caller, &read)))"
---
SELECT server_name, client_name, error_class, caller_fault, sum(count) AS m0, sumMap(dur_hist) AS m1, max(last_seen) AS m2 FROM (SELECT server_name, client_name, error_class, caller_fault, count, dur_hist, last_seen FROM crucible.mcp_tool_rollup WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND (minute < {p3:DateTime('UTC')} OR minute >= {p4:DateTime('UTC')}) AND (side = {p5:String} AND ((server_name IN ({p6:String}) AND capture_source IN ({p7:String})) OR (server_name IN ({p8:String}) AND capture_source IN ({p9:String}, {p10:String})))) UNION ALL SELECT server_name, client_name, error_class, caller_fault, count, dur_hist, last_seen FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p11:UUID} AND hour >= {p12:DateTime('UTC')} AND hour <= {p13:DateTime('UTC')} AND (side = {p14:String} AND ((server_name IN ({p15:String}) AND capture_source IN ({p16:String})) OR (server_name IN ({p17:String}) AND capture_source IN ({p18:String}, {p19:String}))))) GROUP BY server_name, client_name, error_class, caller_fault
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1795512540"
p3: DateTime('UTC') = "1794909600"
p4: DateTime('UTC') = "1795510800"
p5: String = "server"
p6: String = "files"
p7: String = "sdk"
p8: String = "db"
p9: String = "proxy_stdio"
p10: String = "proxy_http"
p11: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p12: DateTime('UTC') = "1794909600"
p13: DateTime('UTC') = "1795510740"
p14: String = "server"
p15: String = "files"
p16: String = "sdk"

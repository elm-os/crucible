SELECT trace_id, name FROM crucible.trace_heads WHERE project_id = {p7:UUID} AND start_time >= {p8:DateTime64(6, 'UTC')} AND start_time < {p9:DateTime64(6, 'UTC')} AND trace_id IN (SELECT trace_id FROM (SELECT trace_id, argMax(op, (version, fact_id)) AS m0 FROM crucible.fact_tags WHERE project_id = {p0:UUID} AND target_time >= {p1:DateTime64(6, 'UTC')} AND target_time < {p2:DateTime64(6, 'UTC')} AND target_day >= {p3:Date} AND target_day <= {p4:Date} AND key = {p5:String} GROUP BY trace_id HAVING m0 = {p6:String})) ORDER BY start_time DESC, trace_hash DESC, trace_id DESC LIMIT {p10:UInt64}

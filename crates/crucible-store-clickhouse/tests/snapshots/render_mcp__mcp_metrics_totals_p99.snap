---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&mcp_metrics_totals(s, w, &c, &p99, &read,\n(true, 51)).unwrap().unwrap())"
---
SELECT target_name, sumMap(dur_hist) AS m0, sum(count) AS m1 FROM crucible.mcp_tool_rollup WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND (side = {p3:String} AND ((server_name IN ({p4:String}) AND capture_source IN ({p5:String})) OR (server_name IN ({p6:String}) AND capture_source IN ({p7:String}, {p8:String}))) AND caller_fault = {p9:UInt8}) GROUP BY target_name ORDER BY m1 DESC, target_name ASC LIMIT {p10:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911340"
p3: String = "server"
p4: String = "files"
p5: String = "sdk"
p6: String = "db"
p7: String = "proxy_stdio"
p8: String = "proxy_http"
p9: UInt8 = "0"
p10: UInt64 = "51"

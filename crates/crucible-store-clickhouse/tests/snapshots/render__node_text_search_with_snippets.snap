---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: "rendered(&plan(QueryClass::Search, Node::TextSearch(search)))"
---
SELECT start_minute, trace_hash, span_id, multiSearchFirstPositionCaseInsensitive(input, [{p5:String}, {p6:String}, {p7:String}, {p8:String}]) AS s0, substring(input, if(s0 > {p9:UInt64}, s0 - {p9:UInt64}, 1), {p10:UInt64}), multiSearchFirstPositionCaseInsensitive(output, [{p5:String}, {p6:String}, {p7:String}, {p8:String}]) AS s1, substring(output, if(s1 > {p9:UInt64}, s1 - {p9:UInt64}, 1), {p10:UInt64}) FROM crucible.span_payload WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND (hasAnyTokens(input, [{p5:String}, {p6:String}, {p7:String}, {p8:String}]) OR hasAnyTokens(metadata_kv, [{p5:String}, {p6:String}, {p7:String}, {p8:String}]) OR hasAnyTokens(output, [{p5:String}, {p6:String}, {p7:String}, {p8:String}])) LIMIT {p11:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000001"
p3: DateTime('UTC') = "1794907800"
p4: DateTime('UTC') = "1794911400"
p5: String = "rate"
p6: String = "limit"
p7: String = "exceeded"
p8: String = "exceeded"
p9: UInt64 = "40"
p10: UInt64 = "160"
p11: UInt64 = "20"

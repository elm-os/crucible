SELECT start_time, trace_hash, trace_id, span_id, head_kind, end_time, name, level, status_code, user_id, session_id, tags, environment, release, version, input_preview, output_preview, wal_epoch, batch_seq, lsn, received_at FROM crucible.trace_heads WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND received_at <= {p3:DateTime64(6, 'UTC')} AND (((hasAny(tags, [{p4:String}]) AND NOT (trace_id IN (SELECT trace_id FROM (SELECT trace_id, argMax(op, (version, fact_id)) AS m0, argMax(retracted, (version, fact_id)) AS m1 FROM crucible.fact_tags WHERE project_id = {p5:UUID} AND target_time >= {p6:DateTime64(6, 'UTC')} AND target_time < {p7:DateTime64(6, 'UTC')} AND target_day >= {p8:Date} AND target_day <= {p9:Date} AND (target_kind = {p10:String} AND key = {p11:String}) GROUP BY trace_id HAVING m0 = {p12:String} AND m1 = {p13:UInt8})))) OR trace_id IN (SELECT trace_id FROM (SELECT trace_id, argMax(op, (version, fact_id)) AS m0, argMax(retracted, (version, fact_id)) AS m1 FROM crucible.fact_tags WHERE project_id = {p14:UUID} AND target_time >= {p15:DateTime64(6, 'UTC')} AND target_time < {p16:DateTime64(6, 'UTC')} AND target_day >= {p17:Date} AND target_day <= {p18:Date} AND (target_kind = {p19:String} AND key = {p20:String}) GROUP BY trace_id HAVING m0 = {p21:String} AND m1 = {p22:UInt8})))) ORDER BY start_time DESC, trace_hash DESC, trace_id DESC LIMIT {p23:UInt64}

SELECT start_time, trace_hash, trace_id, span_id, head_kind, end_time, name, level, status_code, user_id, session_id, tags, environment, release, version, input_preview, output_preview, wal_epoch, batch_seq, lsn, received_at FROM crucible.trace_heads WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND received_at <= {p3:DateTime64(6, 'UTC')} AND environment = {p4:String} AND (start_time, trace_hash, trace_id) < ({p5:DateTime64(6, 'UTC')}, {p6:UInt32}, unhex({p7:String})) ORDER BY start_time DESC, trace_hash DESC, trace_id DESC LIMIT {p8:UInt64}

SELECT parent_span_id, count() AS m0 FROM crucible.span_core WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND (trace_hash = {p5:UInt32} AND trace_id = unhex({p6:String}) AND parent_span_id IN (unhex({p7:String}), unhex({p8:String}), unhex({p9:String}), unhex({p10:String}))) GROUP BY parent_span_id

---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: "rendered(&plan(QueryClass::AnalyticsRaw, Node::TimeSeries(ops)))"
---
SELECT toDateTime(toStartOfDay(toDateTime(start_time, {p0:String})), {p0:String}) AS bucket, count() AS m0, ifNull(sum(progress_count), 0) AS m1, sum(duration_us) AS m2, toNullable(uniqCombined64(user_id)) AS m3, toNullable(min(server_name)) AS m4, toNullable(max(jsonrpc_code)) AS m5 FROM crucible.mcp_ops WHERE project_id = {p4:UUID} AND start_time >= {p5:DateTime64(6, 'UTC')} AND start_time < {p6:DateTime64(6, 'UTC')} AND start_minute >= {p7:DateTime('UTC')} AND start_minute <= {p8:DateTime('UTC')} GROUP BY bucket ORDER BY bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}
p0: String = "UTC"
p1: DateTime('UTC') = "1794873600"
p2: DateTime('UTC') = "1794960000"
p3: UInt64 = "86400"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime64(6, 'UTC') = "1794907800.000000"
p6: DateTime64(6, 'UTC') = "1794911400.000001"
p7: DateTime('UTC') = "1794907800"
p8: DateTime('UTC') = "1794911400"
setting use_with_fill_by_sorting_prefix = 1

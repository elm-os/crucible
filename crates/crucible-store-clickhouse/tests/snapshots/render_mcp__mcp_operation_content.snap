---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&live(mcp_operation_content(s, w, &c, caller,\n(McpSide::Server, trace, span), McpContentField::Result, 16_384)))"
---
SELECT substring(result, {p5:UInt64}, {p6:UInt64}), length(result) FROM crucible.mcp_content WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND side = {p7:String} AND trace_hash = {p8:UInt32} AND trace_id = unhex({p9:String}) AND span_id = unhex({p10:String}) LIMIT 1
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000000"
p3: DateTime('UTC') = "1794907800"
p4: DateTime('UTC') = "1794911340"
p5: UInt64 = "1"
p6: UInt64 = "16384"
p7: String = "server"
p8: UInt32 = "1524766824"
p9: String = "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
p10: String = "0202020202020202"

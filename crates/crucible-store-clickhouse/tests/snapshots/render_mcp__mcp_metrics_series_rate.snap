---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&mcp_metrics_series(s, w, &c, caller, &rate,\n(&read, Some(&keys))).unwrap().unwrap())"
---
SELECT bucket, target_name, error_class, m0 FROM (SELECT toDateTime(toStartOfMinute(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, target_name, error_class, sum(count) AS m0, count() AS matched FROM crucible.mcp_tool_rollup WHERE project_id = {p4:UUID} AND minute >= {p5:DateTime('UTC')} AND minute <= {p6:DateTime('UTC')} AND (side = {p7:String} AND ((server_name IN {p8:Array(String)} AND capture_source IN {p9:Array(String)}) OR (server_name IN {p10:Array(String)} AND capture_source IN {p11:Array(String)})) AND caller_fault = {p12:UInt8} AND target_name IN {p13:Array(String)}) GROUP BY bucket, target_name, error_class ORDER BY target_name ASC, error_class ASC, bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}) QUALIFY max(matched) OVER () > 0 ORDER BY target_name ASC, error_class ASC, bucket ASC
p0: String = "UTC"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911400"
p3: UInt64 = "60"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime('UTC') = "1794907800"
p6: DateTime('UTC') = "1794911340"
p7: String = "server"
p8: Array(String) = "['files']"
p9: Array(String) = "['sdk']"
p10: Array(String) = "['db']"
p11: Array(String) = "['proxy_stdio','proxy_http']"
p12: UInt8 = "0"
p13: Array(String) = "['read_file']"
setting use_with_fill_by_sorting_prefix = 1

---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: rendered(&live(facts))
---
SELECT key, target_day, trace_id, span_id, session_id, version, fact_id, target_kind, target_time, retracted, author_kind, author_id, created_at, data_type, value_num, value_str, comment, source, metadata, config_id, wal_epoch, batch_seq, lsn, received_at FROM crucible.fact_scores WHERE project_id = {p0:UUID} AND target_time >= {p1:DateTime64(6, 'UTC')} AND target_time < {p2:DateTime64(6, 'UTC')} AND target_day >= {p3:Date} AND target_day <= {p4:Date} AND (target_kind IN {p5:Array(String)} AND trace_id IN {p6:Array(FixedString(16))})
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000001"
p3: Date = "2026-11-17"
p4: Date = "2026-11-17"
p5: Array(String) = "['trace','span']"
p6: Array(FixedString(16)) = "['\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1\\xa1','\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07']"

---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&live(mcp_tool_series(s, w, &c, caller, &files, \"read_file\",\nStep::Hour)))"
---
SELECT toDateTime(toStartOfHour(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, error_class, caller_fault, sum(count) AS m0, sumMap(dur_hist) AS m1 FROM (SELECT error_class, caller_fault, count, dur_hist, minute FROM crucible.mcp_tool_rollup WHERE project_id = {p1:UUID} AND minute >= {p2:DateTime('UTC')} AND minute <= {p3:DateTime('UTC')} AND (minute < {p4:DateTime('UTC')} OR minute >= {p5:DateTime('UTC')}) AND (side = {p6:String} AND ((server_name IN ({p7:String}) AND capture_source IN ({p8:String})) OR (server_name IN ({p9:String}) AND capture_source IN ({p10:String}, {p11:String}))) AND server_name = {p12:String} AND method = {p13:String} AND target_name = {p14:String}) UNION ALL SELECT error_class, caller_fault, count, dur_hist, hour AS minute FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p15:UUID} AND hour >= {p16:DateTime('UTC')} AND hour <= {p17:DateTime('UTC')} AND (side = {p18:String} AND ((server_name IN ({p19:String}) AND capture_source IN ({p20:String})) OR (server_name IN ({p21:String}) AND capture_source IN ({p22:String}, {p23:String}))) AND server_name = {p24:String} AND method = {p25:String} AND target_name = {p26:String})) GROUP BY bucket, error_class, caller_fault
p0: String = "UTC"
p1: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p2: DateTime('UTC') = "1794907800"
p3: DateTime('UTC') = "1795512540"
p4: DateTime('UTC') = "1794909600"
p5: DateTime('UTC') = "1795510800"
p6: String = "server"
p7: String = "files"
p8: String = "sdk"
p9: String = "db"
p10: String = "proxy_stdio"
p11: String = "proxy_http"
p12: String = "files"
p13: String = "tools/call"
p14: String = "read_file"
p15: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p16: DateTime('UTC') = "1794909600"
p17: DateTime('UTC') = "1795510740"
p18: String = "server"
p19: String = "files"
p20: String = "sdk"
p21: String = "db"
p22: String = "proxy_stdio"
p23: String = "proxy_http"
p24: String = "files"
p25: String = "tools/call"
p26: String = "read_file"

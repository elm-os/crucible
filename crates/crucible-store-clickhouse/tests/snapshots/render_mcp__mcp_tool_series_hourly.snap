---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&live(mcp_tool_series(s, w, &c, caller, &files, \"read_file\",\nStep::Hour)))"
---
SELECT toDateTime(toStartOfHour(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, error_class, caller_fault, sum(count) AS m0, sumMap(dur_hist) AS m1 FROM (SELECT error_class, caller_fault, count, dur_hist, minute FROM crucible.mcp_tool_rollup WHERE project_id = {p1:UUID} AND minute >= {p2:DateTime('UTC')} AND minute <= {p3:DateTime('UTC')} AND (minute < {p4:DateTime('UTC')} OR minute >= {p5:DateTime('UTC')}) AND (side = {p6:String} AND ((server_name IN {p7:Array(String)} AND capture_source IN {p8:Array(String)}) OR (server_name IN {p9:Array(String)} AND capture_source IN {p10:Array(String)})) AND server_name = {p11:String} AND method = {p12:String} AND target_name = {p13:String}) UNION ALL SELECT error_class, caller_fault, count, dur_hist, hour AS minute FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p14:UUID} AND hour >= {p15:DateTime('UTC')} AND hour <= {p16:DateTime('UTC')} AND (side = {p17:String} AND ((server_name IN {p18:Array(String)} AND capture_source IN {p19:Array(String)}) OR (server_name IN {p20:Array(String)} AND capture_source IN {p21:Array(String)})) AND server_name = {p22:String} AND method = {p23:String} AND target_name = {p24:String})) GROUP BY bucket, error_class, caller_fault
p0: String = "UTC"
p1: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p2: DateTime('UTC') = "1794907800"
p3: DateTime('UTC') = "1795512540"
p4: DateTime('UTC') = "1794909600"
p5: DateTime('UTC') = "1795510800"
p6: String = "server"
p7: Array(String) = "['files']"
p8: Array(String) = "['sdk']"
p9: Array(String) = "['db']"
p10: Array(String) = "['proxy_stdio','proxy_http']"
p11: String = "files"
p12: String = "tools/call"
p13: String = "read_file"
p14: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p15: DateTime('UTC') = "1794909600"
p16: DateTime('UTC') = "1795510740"
p17: String = "server"
p18: Array(String) = "['files']"
p19: Array(String) = "['sdk']"
p20: Array(String) = "['db']"
p21: Array(String) = "['proxy_stdio','proxy_http']"
p22: String = "files"
p23: String = "tools/call"
p24: String = "read_file"

SELECT start_minute, trace_hash, span_id, multiSearchFirstPositionCaseInsensitive(input, [{p9:String}]) AS s0, substring(input, if(s0 > {p10:UInt64}, s0 - {p10:UInt64}, 1), {p11:UInt64}), multiSearchFirstPositionCaseInsensitive(output, [{p9:String}]) AS s1, substring(output, if(s1 > {p10:UInt64}, s1 - {p10:UInt64}, 1), {p11:UInt64}) FROM crucible.span_payload WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND received_at <= {p12:DateTime64(6, 'UTC')} AND (hasAllTokens(input, [{p5:String}, {p6:String}, {p7:String}, {p8:String}]) OR hasAllTokens(output, [{p5:String}, {p6:String}, {p7:String}, {p8:String}])) AND (user_id IN ({p13:String}) AND has(metadata_kv, {p14:String})) AND (start_minute, trace_hash, span_id) < ({p15:DateTime('UTC')}, {p16:UInt32}, unhex({p17:String})) ORDER BY start_minute DESC, trace_hash DESC, span_id DESC LIMIT {p18:UInt64}

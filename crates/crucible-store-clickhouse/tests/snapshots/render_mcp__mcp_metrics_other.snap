---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&mcp_metrics_other(s, w, &c, caller, &errors,\n(&read, &keys)).unwrap().unwrap())"
---
SELECT toDateTime(toStartOfMinute(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, sum(count) AS m0 FROM crucible.mcp_tool_rollup WHERE project_id = {p4:UUID} AND minute >= {p5:DateTime('UTC')} AND minute <= {p6:DateTime('UTC')} AND (side = {p7:String} AND ((server_name IN ({p8:String}) AND capture_source IN ({p9:String})) OR (server_name IN ({p10:String}) AND capture_source IN ({p11:String}, {p12:String}))) AND caller_fault = {p13:UInt8} AND error_class != {p14:String} AND NOT (target_name IN ({p15:String}))) GROUP BY bucket ORDER BY bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}
p0: String = "UTC"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911400"
p3: UInt64 = "60"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime('UTC') = "1794907800"
p6: DateTime('UTC') = "1794911340"
p7: String = "server"
p8: String = "files"
p9: String = "sdk"
p10: String = "db"
p11: String = "proxy_stdio"
p12: String = "proxy_http"
p13: UInt8 = "0"
p14: String = "none"
p15: String = "read_file"
setting use_with_fill_by_sorting_prefix = 1

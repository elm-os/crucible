---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: "rendered(&plan(QueryClass::Analytics, Node::Aggregate(inventory)))"
---
SELECT server_name, tool_name, max(last_seen) AS m0 FROM crucible.mcp_tool_inventory WHERE project_id = {p0:UUID} GROUP BY server_name, tool_name HAVING max(last_seen) >= {p1:DateTime64(6, 'UTC')} AND min(first_seen) < {p2:DateTime64(6, 'UTC')}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime64(6, 'UTC') = "1794907800.000000"
p2: DateTime64(6, 'UTC') = "1794911400.000001"

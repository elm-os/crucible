---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&live(mcp_operations(s, w, &c, caller, &read, &later)))"
---
SELECT trace_id, span_id, parent_span_id, start_time, duration_us, server_name, server_version, deploy_id, capture_source, era, transport, method, target_kind, target_name, status, error_class, error_subclass, caller_fault, jsonrpc_code, error_type, error_message, client_name, client_version, user_id, user_subject_hash, identity_source, group_key, group_key_kind, request_bytes, response_bytes, content_captured, result_type FROM crucible.mcp_ops WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND received_at <= {p5:DateTime64(6, 'UTC')} AND (side = {p6:String} AND capture_source IN {p7:Array(String)} AND caller_fault = {p8:UInt8} AND target_name = {p9:String} AND error_class = {p10:String} AND group_key = {p11:String} AND (user_id = {p12:String} OR user_subject_hash = unhex({p13:String}))) AND (start_minute, start_time, span_id) < ({p14:DateTime('UTC')}, {p15:DateTime64(6, 'UTC')}, unhex({p16:String})) ORDER BY start_minute DESC, start_time DESC, span_id DESC LIMIT {p17:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"

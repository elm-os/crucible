---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&mcp_metrics_series(s, w, &c, caller, &query,\n(&read, Some(&keys))).unwrap().unwrap())"
---
SELECT bucket, target_name, error_class, m0 FROM (SELECT toDateTime(toStartOfHour(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, target_name, error_class, sum(count) AS m0, count() AS matched FROM (SELECT target_name, error_class, count, minute FROM crucible.mcp_tool_rollup WHERE project_id = {p4:UUID} AND minute >= {p5:DateTime('UTC')} AND minute <= {p6:DateTime('UTC')} AND (minute < {p7:DateTime('UTC')} OR minute >= {p8:DateTime('UTC')}) AND (side = {p9:String} AND ((server_name IN ({p10:String}) AND capture_source IN ({p11:String})) OR (server_name IN ({p12:String}) AND capture_source IN ({p13:String}, {p14:String}))) AND caller_fault = {p15:UInt8} AND target_name IN ({p16:String})) UNION ALL SELECT target_name, error_class, count, hour AS minute FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p17:UUID} AND hour >= {p18:DateTime('UTC')} AND hour <= {p19:DateTime('UTC')} AND (side = {p20:String} AND ((server_name IN ({p21:String}) AND capture_source IN ({p22:String})) OR (server_name IN ({p23:String}) AND capture_source IN ({p24:String}, {p25:String}))) AND caller_fault = {p26:UInt8} AND target_name IN ({p27:String}))) GROUP BY bucket, target_name, error_class ORDER BY target_name ASC, error_class ASC, bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}) QUALIFY max(matched) OVER () > 0 ORDER BY target_name ASC, error_class ASC, bucket ASC
p0: String = "UTC"
p1: DateTime('UTC') = "1794906000"
p2: DateTime('UTC') = "1795514400"
p3: UInt64 = "3600"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime('UTC') = "1794907800"
p6: DateTime('UTC') = "1795512540"
p7: DateTime('UTC') = "1794909600"
p8: DateTime('UTC') = "1795510800"
p9: String = "server"
p10: String = "files"
p11: String = "sdk"
p12: String = "db"
p13: String = "proxy_stdio"
p14: String = "proxy_http"
p15: UInt8 = "0"
p16: String = "read_file"
p17: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p18: DateTime('UTC') = "1794909600"
p19: DateTime('UTC') = "1795510740"
p20: String = "server"
p21: String = "files"
p22: String = "sdk"
p23: String = "db"
p24: String = "proxy_stdio"
p25: String = "proxy_http"
p26: UInt8 = "0"
p27: String = "read_file"
setting use_with_fill_by_sorting_prefix = 1

---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "tiered(&mcp_metrics_series(s, w, &c, caller, &query,\n(&read, Some(&keys))).unwrap().unwrap())"
---
SELECT bucket, target_name, error_class, m0 FROM (SELECT toDateTime(toStartOfHour(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, target_name, error_class, sum(count) AS m0, count() AS matched FROM (SELECT target_name, error_class, count, minute FROM crucible.mcp_tool_rollup WHERE project_id = {p4:UUID} AND minute >= {p5:DateTime('UTC')} AND minute <= {p6:DateTime('UTC')} AND (minute < {p7:DateTime('UTC')} OR minute >= {p8:DateTime('UTC')}) AND (side = {p9:String} AND ((server_name IN {p10:Array(String)} AND capture_source IN {p11:Array(String)}) OR (server_name IN {p12:Array(String)} AND capture_source IN {p13:Array(String)})) AND caller_fault = {p14:UInt8} AND target_name IN {p15:Array(String)}) UNION ALL SELECT target_name, error_class, count, hour AS minute FROM crucible.mcp_tool_rollup_hourly WHERE project_id = {p16:UUID} AND hour >= {p17:DateTime('UTC')} AND hour <= {p18:DateTime('UTC')} AND (side = {p19:String} AND ((server_name IN {p20:Array(String)} AND capture_source IN {p21:Array(String)}) OR (server_name IN {p22:Array(String)} AND capture_source IN {p23:Array(String)})) AND caller_fault = {p24:UInt8} AND target_name IN {p25:Array(String)})) GROUP BY bucket, target_name, error_class ORDER BY target_name ASC, error_class ASC, bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}) QUALIFY max(matched) OVER () > 0 ORDER BY target_name ASC, error_class ASC, bucket ASC
p0: String = "UTC"
p1: DateTime('UTC') = "1794906000"
p2: DateTime('UTC') = "1795514400"
p3: UInt64 = "3600"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime('UTC') = "1794907800"
p6: DateTime('UTC') = "1795512540"
p7: DateTime('UTC') = "1794909600"
p8: DateTime('UTC') = "1795510800"
p9: String = "server"
p10: Array(String) = "['files']"
p11: Array(String) = "['sdk']"
p12: Array(String) = "['db']"
p13: Array(String) = "['proxy_stdio','proxy_http']"
p14: UInt8 = "0"
p15: Array(String) = "['read_file']"
p16: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p17: DateTime('UTC') = "1794909600"
p18: DateTime('UTC') = "1795510740"
p19: String = "server"
p20: Array(String) = "['files']"
p21: Array(String) = "['sdk']"
p22: Array(String) = "['db']"
p23: Array(String) = "['proxy_stdio','proxy_http']"
p24: UInt8 = "0"
p25: Array(String) = "['read_file']"
setting use_with_fill_by_sorting_prefix = 1

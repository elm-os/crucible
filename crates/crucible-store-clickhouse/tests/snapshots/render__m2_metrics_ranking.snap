SELECT model_response, observation_type, sum(count) AS m0 FROM crucible.span_metrics WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND level IN {p3:Array(String)} GROUP BY model_response, observation_type ORDER BY m0 DESC, model_response ASC, observation_type ASC LIMIT {p4:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911400"
p3: Array(String) = "['error']"
p4: UInt64 = "6"

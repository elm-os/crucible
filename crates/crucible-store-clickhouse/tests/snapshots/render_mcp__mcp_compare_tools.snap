---
source: crates/crucible-store-clickhouse/tests/render_mcp.rs
expression: "rendered(&live(mcp_compare_tools(s, w, &c, caller, &files, &deploys)))"
---
SELECT deploy_id, target_name, error_class, caller_fault, sum(count) AS m0, sumMap(dur_hist) AS m1 FROM crucible.mcp_tool_rollup WHERE project_id = {p0:UUID} AND minute >= {p1:DateTime('UTC')} AND minute <= {p2:DateTime('UTC')} AND (side = {p3:String} AND ((server_name IN {p4:Array(String)} AND capture_source IN {p5:Array(String)}) OR (server_name IN {p6:Array(String)} AND capture_source IN {p7:Array(String)})) AND server_name = {p8:String} AND method = {p9:String} AND deploy_id IN {p10:Array(String)}) GROUP BY deploy_id, target_name, error_class, caller_fault
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: DateTime('UTC') = "1794907800"
p2: DateTime('UTC') = "1794911340"
p3: String = "server"
p4: Array(String) = "['files']"
p5: Array(String) = "['sdk']"
p6: Array(String) = "['db']"
p7: Array(String) = "['proxy_stdio','proxy_http']"
p8: String = "files"
p9: String = "tools/call"
p10: Array(String) = "['v1','v2']"

SELECT trace_id, min(min_start) AS m0, max(max_end) AS m1, max(has_root) AS m2, min(min_head_start) AS m3, sum(span_count) AS m4, sum(error_count) AS m5, sum(total_cost_nusd) AS m6, sum(input_tokens) AS m7, sum(output_tokens) AS m8, sum(total_tokens) AS m9, max(trace_name_pick) AS m10, max(user_id_pick) AS m11, max(session_id_pick) AS m12 FROM crucible.trace_stats WHERE project_id = {p0:UUID} AND row_day >= {p1:Date} AND row_day <= {p2:Date} AND trace_id IN {p3:Array(FixedString(16))} GROUP BY trace_id

---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: "rendered(&series(Step::Hour, Fill::Zero))"
---
SELECT bucket, environment, m0 FROM (SELECT toDateTime(toStartOfHour(toDateTime(minute, {p0:String})), {p0:String}) AS bucket, environment, sum(count) AS m0, count() AS matched FROM crucible.span_metrics WHERE project_id = {p4:UUID} AND minute >= {p5:DateTime('UTC')} AND minute <= {p6:DateTime('UTC')} GROUP BY bucket, environment ORDER BY environment ASC, bucket ASC WITH FILL FROM {p1:DateTime('UTC')} TO {p2:DateTime('UTC')} STEP {p3:UInt64}) QUALIFY max(matched) OVER () > 0 ORDER BY environment ASC, bucket ASC
p0: String = "UTC"
p1: DateTime('UTC') = "1794906000"
p2: DateTime('UTC') = "1794913200"
p3: UInt64 = "3600"
p4: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p5: DateTime('UTC') = "1794907800"
p6: DateTime('UTC') = "1794911400"
setting use_with_fill_by_sorting_prefix = 1

SELECT name, start_time, tags FROM crucible.span_core WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND received_at <= {p5:DateTime64(6, 'UTC')} AND received_at > {p6:DateTime64(6, 'UTC')} AND ((name = {p7:String} OR NOT (total_tokens <= {p8:UInt64})) AND span_id IN (unhex({p9:String}), unhex({p10:String}), unhex({p11:String}), unhex({p12:String})) AND startsWith(environment, {p13:String}) AND hasAny(tags, [{p14:String}, {p15:String}, {p16:String}, {p17:String}, {p18:String}, {p19:String}, {p20:String}, {p21:String}]) AND (positionCaseInsensitiveUTF8(name, {p22:String}) > 0 AND (lengthUTF8({p22:String}) < 3 OR hasAllTokens(name, {p22:String}))) AND level = {p23:String} AND total_cost_nusd != {p24:Int64} AND price_model_id = {p25:UUID} AND completion_start_time > {p26:DateTime64(6, 'UTC')} AND 0) AND (start_time, span_id) < ({p27:DateTime64(6, 'UTC')}, unhex({p28:String})) ORDER BY start_time DESC, span_id DESC LIMIT {p29:UInt64}

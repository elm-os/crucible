SELECT name, start_time, tags FROM crucible.span_core WHERE project_id = {p0:UUID} AND start_time >= {p1:DateTime64(6, 'UTC')} AND start_time < {p2:DateTime64(6, 'UTC')} AND start_minute >= {p3:DateTime('UTC')} AND start_minute <= {p4:DateTime('UTC')} AND received_at <= {p5:DateTime64(6, 'UTC')} AND received_at > {p6:DateTime64(6, 'UTC')} AND ((name = {p7:String} OR NOT (total_tokens <= {p8:UInt64})) AND span_id IN {p9:Array(FixedString(8))} AND startsWith(environment, {p10:String}) AND hasAny(tags, {p11:Array(String)}) AND (positionCaseInsensitiveUTF8(name, {p12:String}) > 0 AND (lengthUTF8({p12:String}) < 3 OR hasAllTokens(name, {p12:String}))) AND level = {p13:String} AND total_cost_nusd != {p14:Int64} AND price_model_id = {p15:UUID} AND completion_start_time > {p16:DateTime64(6, 'UTC')} AND 0) AND (start_time, span_id) < ({p17:DateTime64(6, 'UTC')}, unhex({p18:String})) ORDER BY start_time DESC, span_id DESC LIMIT {p19:UInt64}

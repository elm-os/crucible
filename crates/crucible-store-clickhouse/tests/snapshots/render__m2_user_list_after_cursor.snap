---
source: crates/crucible-store-clickhouse/tests/render.rs
expression: rendered(&list)
---
SELECT user_id, max(last_seen) AS m0, min(first_seen) AS m1, sum(trace_count) AS m2, sum(span_count) AS m3, sum(error_count) AS m4, sum(total_cost_nusd) AS m5, sum(input_tokens) AS m6, sum(output_tokens) AS m7, sum(total_tokens) AS m8 FROM crucible.user_rollup WHERE project_id = {p0:UUID} AND day >= {p1:Date} AND day <= {p2:Date} GROUP BY user_id HAVING (m0, user_id) < ({p3:DateTime64(6, 'UTC')}, {p4:String}) ORDER BY m0 DESC, user_id DESC LIMIT {p5:UInt64}
p0: UUID = "0193a1b2-7c3d-7e4f-8a5b-6c7d8e9f0a1b"
p1: Date = "2026-11-17"
p2: Date = "2026-11-17"
p3: DateTime64(6, 'UTC') = "1794907800.000000"
p4: String = "user-9"
p5: UInt64 = "51"

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/generated/**", "ui/out/**", "ui/.next/**", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["ui/**"],
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}

# Rust
/target/
**/*.rs.bk
# Pending insta snapshots that a failing test writes beside the committed ones (binary snapshots add .snap.new.<ext>)
*.snap.new
*.snap.new.*

# Node / UI
node_modules/
/ui/.next/
/ui/out/
/ui/test-results/
/ui/playwright-report/
/ui/next-env.d.ts
*.tsbuildinfo
.pnpm-store/

# TypeScript SDK build output
/sdk/typescript/dist/

# Python
__pycache__/
*.pyc
.venv/
/sdk/python/dist/

# Go
/sdk/go/bin/

# Local state
.env
.env.*
!.env.example
*.log
/perf/results/local/
/sim/runs/
/fuzz/artifacts/
/fuzz/coverage/
graphify-out/
.DS_Store
Thumbs.db
desktop.ini
# The ban self-test resolves its own (exactly pinned) dependencies; a committed lock would pin crucible-records' tree.
/tools/ban-selftest/Cargo.lock

# A server run from the repository root: the default data directory (data.dir), its keys file and its configuration file
/data/
/keys.toml
/crucible.toml

# The server configuration that crates/crucible-schema/scripts/conformance.sh writes for a run and removes after it
/crates/crucible-schema/tests/conformance/.server-config.xml

# Editor files and merge or patch leftovers
.idea/
.vscode/
*.swp
*~
*.bak
*.orig
*.rej

# Per-developer overrides of the git hooks (lefthook)
/lefthook-local.yml
/.lefthook-local/

# Formal tools
_apalache-out/
specs/tmp/
# Fuzz crates resolve their own dependencies; a committed lock drifts whenever a fuzzed crate's dependencies change.
/crates/*/fuzz/Cargo.lock

# The development Compose file's local inputs (docs/self-hosting/quickstart.md)
/deploy/compose/bin/
/deploy/compose/keys.toml
/deploy/compose/.env
/e2e-out/

# Local agent configuration and installed skills are not committed (skills-lock.json records the skills' sources)
.claude/
.agents/
/CLAUDE.local.md

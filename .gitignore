# Rust
/target/
**/*.rs.bk

# Node / UI
node_modules/
/ui/.next/
/ui/out/
/ui/test-results/
/ui/playwright-report/
/ui/next-env.d.ts
*.tsbuildinfo
.pnpm-store/

# TypeScript SDK build output
/sdk/typescript/dist/

# Python
__pycache__/
*.pyc
.venv/
/sdk/python/dist/

# Go
/sdk/go/bin/

# Local state
.env
.env.*
!.env.example
*.log
/perf/results/local/
/sim/runs/
/fuzz/artifacts/
/fuzz/coverage/
graphify-out/
.DS_Store
Thumbs.db
# The ban self-test resolves its own (exactly pinned) dependencies; a committed lock would pin crucible-records' tree.
/tools/ban-selftest/Cargo.lock

# Formal tools
_apalache-out/
specs/tmp/
# Fuzz crates resolve their own dependencies; a committed lock drifts whenever a fuzzed crate's dependencies change.
/crates/*/fuzz/Cargo.lock

# The development Compose file's local inputs (docs/self-hosting/quickstart.md)
/deploy/compose/bin/
/deploy/compose/keys.toml
/deploy/compose/.env
/e2e-out/

# Local Claude Code configuration and installed skills are not committed (skills-lock.json records the skills' sources)
.claude/
